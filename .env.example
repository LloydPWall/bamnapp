# Copy this file to .env on the server and fill in your values.
# .env is gitignored — never commit it.

PORT=3000
POLL_INTERVAL=120000

# Secret key used to authenticate with Google Apps Script proxies
SECRET=your_secret_key_here

# Google Apps Script proxy endpoints
SCHED_PROXY=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
RESV_PROXY=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
TIPS_PROXY=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
NOTICES_PROXY=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
MENU_PROXY=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
SPECS_PROXY=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
